# Kintsugi theme for fish shell
# https://github.com/metalelf0/kintsugi-nvim
#
# Usage:
#   source ~/path/to/extras/fish/kintsugi.fish
# Or drop it into ~/.config/fish/conf.d/

set -U fish_color_autosuggestion  75715e
set -U fish_color_cancel          -r
set -U fish_color_command         dddddd
set -U fish_color_comment         af9661
set -U fish_color_cwd             a3be8c
set -U fish_color_cwd_root        b38f8f
set -U fish_color_end             868165
set -U fish_color_error           b38f8f
set -U fish_color_escape          678e87
set -U fish_color_history_current --bold
set -U fish_color_host            normal
set -U fish_color_host_remote     8fa3b3
set -U fish_color_keyword         dbad49 --bold
set -U fish_color_match           --background=393b31
set -U fish_color_normal          dddddd
set -U fish_color_operator        dbad49
set -U fish_color_option          c9c4b8
set -U fish_color_param           c9c4b8
set -U fish_color_quote           98c379
set -U fish_color_redirection     ebcb8b
set -U fish_color_search_match    --background=393b31
set -U fish_color_selection       --background=393b31
set -U fish_color_status          b38f8f
set -U fish_color_user            8fa3b3
set -U fish_color_valid_path      --underline

set -U fish_pager_color_background
set -U fish_pager_color_completion         dddddd
set -U fish_pager_color_description        75715e
set -U fish_pager_color_prefix             dbad49 --bold
set -U fish_pager_color_progress           ebcb8b
set -U fish_pager_color_selected_background --background=393b31
set -U fish_pager_color_selected_completion dddddd
set -U fish_pager_color_selected_description 75715e
